# Local development only. Copy to .env (gitignored), then choose your own
# passwords and match them to roles provisioned in your PostgreSQL database.
# Do not use these placeholders as credentials or deploy this dev identity mode.
BLOCKS_ENV=dev

BLOCKS_DB_HOST=localhost
BLOCKS_DB_PORT=5432
BLOCKS_DB_NAME=blocks
BLOCKS_DB_APP_USER=blocks_app
BLOCKS_DB_APP_PASSWORD=change-me-app
BLOCKS_DB_MIGRATOR_USER=blocks_migrator
BLOCKS_DB_MIGRATOR_PASSWORD=change-me-migrator
BLOCKS_DB_DISPATCHER_USER=blocks_dispatcher
BLOCKS_DB_DISPATCHER_PASSWORD=change-me-dispatcher

# Tests require BLOCKS_TEST_ADMIN_DSN in the process environment. Supply a
# locally provisioned blocks_test_admin role with CREATEDB and no BYPASSRLS.
# Do not point the test harness at a shared or production database.

# dev substitutes a local token verifier for OIDC and is refused in production.
BLOCKS_IDENTITY_MODE=dev
BLOCKS_DEV_TOKEN_SECRET=change-me-local-signing-secret

# Required when BLOCKS_IDENTITY_MODE=oidc:
#BLOCKS_OIDC_ISSUER=
#BLOCKS_OIDC_AUDIENCE=
#BLOCKS_OIDC_JWKS_URL=
