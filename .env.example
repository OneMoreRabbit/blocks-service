# Development configuration. Copy to .env (which is gitignored) and adjust.
# Every value here is a DEVELOPMENT value against the seat's platform PostgreSQL
# container. No production, cloud, OIDC, or signing secret belongs in this file
# or anywhere else in this repository.

BLOCKS_ENV=dev

BLOCKS_DB_HOST=postgres
BLOCKS_DB_PORT=5432
BLOCKS_DB_NAME=blocks
BLOCKS_DB_APP_USER=blocks_app
BLOCKS_DB_APP_PASSWORD=blocks-dev-app
BLOCKS_DB_MIGRATOR_USER=blocks_migrator
BLOCKS_DB_MIGRATOR_PASSWORD=blocks-dev-migrator

# Admin DSN for the test harness and tools/restore_drill.py. NOT a superuser:
# blocks_test_admin is CREATEDB, NOSUPERUSER, NOBYPASSRLS and a member of
# blocks_owner. The suite exists to prove tenant isolation, so it must not run as
# a role exempt from it.
#
# Leave this unset on a seat: the harness reads the password from
# ~/.secrets/blocks_test_admin_password, delivered seat-locally by the
# orchestrator. It is deliberately not in this repository or the Atlas vault.
#BLOCKS_TEST_ADMIN_DSN=host=postgres port=5432 user=blocks_test_admin password=... dbname=blocks

# `dev` substitutes a local HS256 verifier for the OIDC one. Settings refuses
# this combination when BLOCKS_ENV=production.
BLOCKS_IDENTITY_MODE=dev
BLOCKS_DEV_TOKEN_SECRET=blocks-dev-insecure-signing-key-do-not-deploy

# Required when BLOCKS_IDENTITY_MODE=oidc. Set exactly one audience form:
# the legacy scalar, or a non-empty JSON array of exact audience strings.
#BLOCKS_OIDC_ISSUER=
#BLOCKS_OIDC_AUDIENCE=
#BLOCKS_OIDC_AUDIENCES=["blocks-android.example.test","blocks-web.example.test"]
#BLOCKS_OIDC_JWKS_URL=
