# Development configuration. Copy to .env (which is gitignored) and adjust.
# Every value here is a DEVELOPMENT value against the seat's platform PostgreSQL
# container. No production, cloud, OIDC, or signing secret belongs in this file
# or anywhere else in this repository.

BLOCKS_ENV=dev

BLOCKS_DB_HOST=postgres
BLOCKS_DB_PORT=5432
BLOCKS_DB_NAME=blocks
BLOCKS_DB_APP_USER=blocks_app
BLOCKS_DB_APP_PASSWORD=blocks-dev-app
BLOCKS_DB_MIGRATOR_USER=blocks_migrator
BLOCKS_DB_MIGRATOR_PASSWORD=blocks-dev-migrator

# Superuser DSN. Used only by tools/dev_db.py and the test harness, never by the
# running service. In a deployed environment the orchestrator provisions roles
# and this is not present at all.
BLOCKS_ADMIN_DSN=host=postgres port=5432 user=blocks password=blocks-dev dbname=blocks

# `dev` substitutes a local HS256 verifier for the OIDC one. Settings refuses
# this combination when BLOCKS_ENV=production.
BLOCKS_IDENTITY_MODE=dev
BLOCKS_DEV_TOKEN_SECRET=blocks-dev-insecure-signing-key-do-not-deploy

# Required when BLOCKS_IDENTITY_MODE=oidc.
#BLOCKS_OIDC_ISSUER=
#BLOCKS_OIDC_AUDIENCE=
#BLOCKS_OIDC_JWKS_URL=
